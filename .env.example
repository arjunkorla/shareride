# Copy to .env and fill in real values for local development.
# Never commit a real .env file.

# --- Database ---
DATABASE_URL="postgresql://shareride:shareride@localhost:5432/shareride?schema=public"
DIRECT_DATABASE_URL="postgresql://shareride:shareride@localhost:5432/shareride?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Supabase Auth ---
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Google Maps Platform ---
# Also read server-side by apps/api's matching module (Routes API, for real
# driving-distance detour scoring) — needs the Routes API enabled on
# whatever Google Cloud project this key belongs to, in addition to Maps
# SDK for apps/mobile. Matching falls back to a straight-line distance
# estimate when this is unset, so it still works without it.
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# --- Razorpay (Phase 11) ---
# KEY_ID is safe to expose to the mobile checkout SDK; KEY_SECRET and
# WEBHOOK_SECRET must never leave apps/api. Payments fail closed (503,
# not a fake success) when these are unset — see
# apps/api/src/payments/razorpay.service.ts.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set when configuring the webhook endpoint in the Razorpay dashboard
# (Settings -> Webhooks), not the same value as KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=""

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# --- SMS provider (OTP) ---
SMS_PROVIDER_KEY=""

# --- Observability ---
SENTRY_DSN=""

# --- API ---
API_PORT=4000
API_URL="http://localhost:4000"
NODE_ENV="development"

# --- Admin (Next.js) ---
# Next.js only inlines env vars prefixed NEXT_PUBLIC_ into the browser bundle;
# the admin app's Supabase client is safe to use the public anon key here.
ADMIN_PORT=4100
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Mobile (Expo) ---
# Same idea: only EXPO_PUBLIC_-prefixed vars are readable from app code.
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
