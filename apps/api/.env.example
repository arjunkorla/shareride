# apps/api environment template — variable NAMES and placeholders only.
# Copy to apps/api/.env (git-ignored by the root .gitignore's `.env*` rule)
# and replace every <...> placeholder. Never commit apps/api/.env.
#
# The API loads .env from its working directory (ConfigModule.forRoot with
# no envFilePath), i.e. apps/api/ when started via `pnpm --filter
# @shareride/api dev`. Startup validation (src/common/config/env-validation.ts)
# fails fast if DATABASE_URL or SUPABASE_URL is missing.
#
# NOT needed anywhere in this API — do not add them:
#   - Supabase service-role key
#   - Supabase JWT secret (tokens are verified against the project's public
#     JWKS: <SUPABASE_URL>/auth/v1/.well-known/jwks.json, RS256/ES256 only)

# ---------------------------------------------------------------- required

# Runtime connection (Prisma `url`). For Supabase: the TRANSACTION pooler
# (Supavisor, port 6543) — `pgbouncer=true` is required there because
# transaction mode doesn't support prepared statements.
#   postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres?pgbouncer=true&schema=public
DATABASE_URL="<transaction-pooler-connection-string>"

# Migrations only (Prisma `directUrl`, used by `prisma migrate deploy`).
# For Supabase: the SESSION pooler (port 5432 on the pooler host — IPv4),
# or the direct db.<project-ref>.supabase.co:5432 host if your network has
# IPv6. Never the transaction pooler.
#   postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres?schema=public
DIRECT_DATABASE_URL="<session-pooler-or-direct-connection-string>"

# Supabase project URL, e.g. https://<project-ref>.supabase.co (no trailing
# slash). Used as the JWT issuer (<SUPABASE_URL>/auth/v1) and JWKS source.
SUPABASE_URL="<supabase-project-url>"

# ioredis URL. redis:// = plain TCP (local Redis); rediss:// = TLS (hosted,
# e.g. Upstash): rediss://default:<password>@<host>:<port>
# Checked on every authenticated request (token revocation list).
REDIS_URL="<redis-or-rediss-url>"

# ---------------------------------------------------------------- defaults

API_PORT=4000
NODE_ENV="development"

# ---------------------------------------------------------------- optional
# Leave empty to disable; each degrades gracefully when unset.

# Server-side Routes API for driving-distance matching (falls back to a
# straight-line estimate when unset).
GOOGLE_MAPS_API_KEY=""

# Payments fail closed (503 "Payments are not configured") when unset.
# KEY_SECRET and WEBHOOK_SECRET must never leave this API.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Error reporting; no-op when unset.
SENTRY_DSN=""
