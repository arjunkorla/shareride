// ShareRide database schema — Phase 0/1 subset.
//
// Covers: identity, verification, vehicles, the request/offer/match/trip
// core loop, reviews, notifications, locations, and admin/audit. Chat,
// payments/wallet, and support-ticket tables are intentionally deferred to
// later migration phases (see docs/migration-plan.md) and are not modeled
// here yet — do not add mock data for modules that have no table.
//
// Deliberately absent: any seat_count / available_seats / selected_seats
// column anywhere. See docs/current-architecture.md §5.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [postgis(schema: "extensions")]
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String        @id @default(uuid())
  phone         String?       @unique
  email         String?       @unique
  fullName      String
  avatarUrl     String?
  accountStatus AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  roles           UserRole[]
  driverProfile   DriverProfile?
  passengerProfile PassengerProfile?
  vehicles        Vehicle[]
  rideRequests    RideRequest[]
  rideOffers      RideOffer[]
  tripsAsPassenger Trip[]         @relation("TripPassenger")
  tripsAsDriver    Trip[]         @relation("TripDriver")
  reviewsWritten  Review[]        @relation("ReviewAuthor")
  reviewsReceived Review[]        @relation("ReviewRecipient")
  notifications   Notification[]
  emergencyContacts EmergencyContact[]
  messagesSent    Message[]
  conversationReads ConversationRead[]
  reportsFiled    Report[]        @relation("ReportReporter")
  reportsAgainst  Report[]        @relation("ReportReportedUser")
  supportTickets  SupportTicket[]
  payments        Payment[]

  @@map("users")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN

  @@map("user_role")
}

// Suspend = temporary, reversible via Reactivate. Block = admin-initiated,
// reversible via Unblock. Distinct states (not booleans) so the admin UI
// and audit trail can tell them apart — see the Admin User Management brief.
enum AccountStatus {
  ACTIVE
  SUSPENDED
  BLOCKED

  @@map("account_status")
}

enum VerificationStatus {
  NOT_STARTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTION_REQUIRED

  @@map("verification_status")
}

model DriverProfile {
  userId               String              @id
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                  String?
  languages            String[]
  yearsActive          Int                 @default(0)
  verificationStatus   VerificationStatus  @default(NOT_STARTED)
  // Set by an admin on reject/request-info (Verification Management brief) —
  // the reason shown back to the driver, never auto-generated.
  verificationNote     String?
  rating               Decimal             @default(0) @db.Decimal(3, 2)
  totalTrips           Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("drivers")
}

model PassengerProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Decimal  @default(0) @db.Decimal(3, 2)
  totalTrips  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("passengers")
}

enum FuelType {
  PETROL
  DIESEL
  EV
  CNG

  @@map("fuel_type")
}

model Vehicle {
  id                   String              @id @default(uuid())
  driverId             String
  driver               User                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  make                 String
  model                String
  year                 Int
  color                String
  fuelType             FuelType
  registrationNumber   String              @unique
  ac                   Boolean             @default(true)
  photoUrl             String?
  verificationStatus   VerificationStatus  @default(NOT_STARTED)
  verificationNote     String?
  // Soft-deactivate, not delete — a Vehicle can be the FK target of past
  // RideOffers, so removing the row would break trip/offer history.
  // Deactivated vehicles are excluded from the driver's active list and
  // can't be selected for a new RideOffer (Phase 10).
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  rideOffers RideOffer[]

  @@index([driverId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Locations (Hyderabad-first seed data, city-agnostic schema)
// ---------------------------------------------------------------------------

model City {
  id        String   @id @default(uuid())
  name      String
  state     String
  country   String   @default("India")
  isActive  Boolean  @default(true)
  areas     Area[]

  @@unique([name, state])
  @@map("cities")
}

model Area {
  id     String @id @default(uuid())
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name   String

  @@index([cityId])
  @@map("areas")
}

// ---------------------------------------------------------------------------
// Core loop: RideRequest <-> RideOffer -> Match -> RideAgreement -> Trip
// ---------------------------------------------------------------------------

enum RideRequestStatus {
  ACTIVE
  MATCHED
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED

  @@map("ride_request_status")
}

model RideRequest {
  id                     String             @id @default(uuid())
  passengerId            String
  passenger              User               @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  origin                 String
  destination            String
  originCoordinates      Unsupported("extensions.geometry(Point, 4326)")
  destinationCoordinates Unsupported("extensions.geometry(Point, 4326)")
  preferredDate          DateTime           @db.Date
  preferredTimeStart     String
  preferredTimeEnd       String
  preferences            Json               @default("{}")
  notes                  String?
  status                 RideRequestStatus  @default(ACTIVE)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  expiresAt              DateTime

  matches Match[]

  @@index([passengerId])
  @@index([status])
  // Without these, MatchingService's ST_DWithin proximity queries
  // (matching.service.ts) do a sequential scan computing the distance
  // geometry for every row on every matching run — a real, unbounded-cost
  // query the schema-diff baseline migration would otherwise silently
  // ship without (Phase 13 finding: caught during migration-baseline
  // validation, not before).
  @@index([originCoordinates], type: Gist)
  @@index([destinationCoordinates], type: Gist)
  @@map("ride_requests")
}

enum RideOfferStatus {
  ACTIVE
  MATCHED
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED

  @@map("ride_offer_status")
}

model RideOffer {
  id                     String           @id @default(uuid())
  driverId               String
  driver                 User             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId              String
  vehicle                Vehicle          @relation(fields: [vehicleId], references: [id])
  origin                 String
  destination             String
  originCoordinates      Unsupported("extensions.geometry(Point, 4326)")
  destinationCoordinates Unsupported("extensions.geometry(Point, 4326)")
  departureDate          DateTime         @db.Date
  departureTime          String
  stops                  String[]
  pricePerPerson         Decimal          @db.Decimal(10, 2)
  preferences            Json             @default("{}")
  notes                  String?
  status                 RideOfferStatus  @default(ACTIVE)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  expiresAt              DateTime

  matches Match[]

  @@index([driverId])
  @@index([status])
  // See RideRequest's matching identical comment — the other side of the
  // same ST_DWithin proximity query.
  @@index([originCoordinates], type: Gist)
  @@index([destinationCoordinates], type: Gist)
  @@map("ride_offers")
}

enum MatchStatus {
  SUGGESTED
  REQUESTED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  CONFIRMED

  @@map("match_status")
}

model Match {
  id                        String       @id @default(uuid())
  rideRequestId             String
  rideRequest               RideRequest  @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
  rideOfferId                String
  rideOffer                 RideOffer    @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)
  matchStatus                MatchStatus  @default(SUGGESTED)
  originDistanceMeters       Int
  destinationDistanceMeters  Int
  routeCompatibility          Decimal      @db.Decimal(4, 3)
  timeCompatibility            Decimal      @db.Decimal(4, 3)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  expiresAt                  DateTime

  agreement RideAgreement?

  @@unique([rideRequestId, rideOfferId])
  @@index([matchStatus])
  @@map("matches")
}

model RideAgreement {
  id           String   @id @default(uuid())
  matchId      String   @unique
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  passengerId  String
  driverId     String
  confirmedAt  DateTime @default(now())

  trip Trip?

  @@map("ride_agreements")
}

enum TripStatus {
  CONFIRMED
  DRIVER_ARRIVING
  AT_PICKUP
  STARTED
  ONGOING
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

model Trip {
  id              String          @id @default(uuid())
  rideAgreementId String          @unique
  rideAgreement   RideAgreement   @relation(fields: [rideAgreementId], references: [id], onDelete: Cascade)
  passengerId     String
  passenger       User            @relation("TripPassenger", fields: [passengerId], references: [id])
  driverId        String
  driver          User            @relation("TripDriver", fields: [driverId], references: [id])
  status          TripStatus      @default(CONFIRMED)
  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  events  TripEvent[]
  reviews Review[]
  reports Report[]
  payment Payment?

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@map("trips")
}

model TripEvent {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tripId])
  @@map("trip_events")
}

// ---------------------------------------------------------------------------
// Payments (Phase 11)
// ---------------------------------------------------------------------------

// Only Razorpay is integrated; the column exists (rather than being
// implicit) because a future cash/other-provider path would need to slot
// in beside it without a migration that touches every existing row.
enum PaymentProvider {
  RAZORPAY

  @@map("payment_provider")
}

// PENDING: local Payment + Razorpay order created, no checkout result yet.
// AUTHORIZED: Razorpay authorized but not yet captured (manual-capture
// flows only — this account's checkout auto-captures, so most payments
// skip straight PENDING -> PAID, but the state exists for correctness).
// PAID/FAILED: terminal from a checkout attempt. REFUND_PENDING/REFUNDED:
// set only via PaymentRefund, never directly.
enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED

  @@map("payment_status")
}

// One Payment per Trip (no seat capacity, ever, applies here too — a Trip
// is one passenger + one driver agreement, so it needs exactly one
// charge). amount is integer paise, never a float, and is never supplied
// by the client — PaymentsService reads it from the Trip's underlying
// RideAgreement -> Match -> RideOffer.pricePerPerson (the only real price
// in this schema; there is no platform fee/commission field anywhere —
// see docs/migration-plan.md Phase 11 for why none is invented here).
// tripId is @unique, not just indexed — one Payment row per Trip for its
// entire lifecycle (PENDING -> PAID, or PENDING -> FAILED -> PENDING again
// on retry with a fresh providerOrderId), rather than a new row per
// attempt. That single unique constraint IS the server-side idempotency
// guard PaymentsService.createOrder() relies on: a repeated "Pay" tap
// upserts the same row instead of racing to insert two.
model Payment {
  id                String          @id @default(uuid())
  tripId            String          @unique
  trip              Trip            @relation(fields: [tripId], references: [id])
  payerId           String
  payer             User            @relation(fields: [payerId], references: [id])
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  amount            Int
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  failureReason     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paidAt            DateTime?

  refund        PaymentRefund?
  webhookEvents PaymentWebhookEvent[]

  @@index([payerId])
  @@map("payments")
}

// Architecture boundary only — nothing calls Razorpay's refund API
// automatically anywhere in this codebase; a refund only ever starts from
// an explicit admin action (apps/api/src/admin/payments), never
// client-initiated and never on a timer/policy this repo doesn't define.
model PaymentRefund {
  id                  String   @id @default(uuid())
  paymentId           String   @unique
  payment             Payment  @relation(fields: [paymentId], references: [id])
  providerRefundId    String?  @unique
  amount              Int
  status              String   @default("REQUESTED")
  requestedByAdminId  String?
  reason              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("payment_refunds")
}

// providerEventId is Razorpay's X-Razorpay-Event-Id header value — the
// @unique constraint IS the idempotency guard (a duplicate delivery's
// insert fails, handled as "already processed", not a duplicate
// state transition). payload is stored verbatim for reconciliation/
// dispute investigation, never logged to stdout.
model PaymentWebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider @default(RAZORPAY)
  providerEventId String          @unique
  eventType       String
  paymentId       String?
  payment         Payment?        @relation(fields: [paymentId], references: [id])
  payload         Json
  processedAt     DateTime        @default(now())

  @@map("payment_webhook_events")
}

// ---------------------------------------------------------------------------
// Reviews, notifications, safety
// ---------------------------------------------------------------------------

model Review {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  recipientId String
  recipient   User     @relation("ReviewRecipient", fields: [recipientId], references: [id])
  rating      Int
  comment     String?
  categories  String[]
  createdAt   DateTime @default(now())

  @@unique([tripId, authorId, recipientId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  deepLink  String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  relation  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("emergency_contacts")
}

// ---------------------------------------------------------------------------
// Chat (Phase 9)
// ---------------------------------------------------------------------------

// memberIds is a plain Postgres array (like RideOffer.stops), not a join
// table — Prisma's `hasEvery`/`has` filters query it natively via the
// typed client, no PostGIS-style Unsupported/raw-SQL workaround needed
// here. tripId is deliberately NOT a relation (no matching field added to
// Trip) — a conversation may exist before a Trip does (chatting about a
// pending match) and this phase has no read path that needs to join
// Trip -> Conversation, so a plain optional identifier is enough.
// pairKey is a DB-level fix for the race documented in Phase 9/10/11: two
// concurrent ChatService.start() calls for the same two users could both
// pass the old "find existing, then create" check before either insert
// committed, producing two Conversation rows for one pair. pairKey is the
// two member ids sorted and joined ("<lowerId>:<higherId>"), computed
// SERVER-SIDE ONLY (never client input) in ChatService.start() — the
// @unique constraint makes a duplicate a real, guaranteed-caught
// P2002 at the database level instead of a best-effort application check.
// Group chat (more than 2 members) would need a different key, but this
// schema is 1:1-only for now (see Message/Conversation's own comments).
model Conversation {
  id        String   @id @default(uuid())
  tripId    String?
  memberIds String[]
  pairKey   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  reads    ConversationRead[]

  @@map("conversations")
}

// Lowercase values, matching packages/types/src/chat.ts's MessageType
// exactly (unlike most other enums in this schema, which are uppercase —
// chat.ts and notification.ts were already lowercase before this phase,
// so this follows the existing convention for those two rather than the
// majority one).
enum MessageType {
  text
  image
  location
  ride
  quick_reply

  @@map("message_type")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  type           MessageType  @default(text)
  text           String?
  attachmentUrl  String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Additive, minimal durable read-state: one row per (conversation, member)
// holding when THEY last opened it — not a full participant/membership
// table (Conversation.memberIds already is that), just enough to answer
// "unread since when" per member. A conversation's unread count for user X
// = messages in it with senderId != X and createdAt > their lastReadAt (or
// > the conversation's createdAt if they've never read it at all, i.e. no
// row here yet). Deliberately not a per-message MessageRead row — this
// product only needs a per-conversation watermark, not WhatsApp-style
// per-message read receipts.
model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@id([conversationId, userId])
  @@map("conversation_reads")
}

// ---------------------------------------------------------------------------
// Admin, RBAC & audit
// ---------------------------------------------------------------------------

// A fixed catalog of dot-namespaced permission strings (e.g. "user.suspend",
// "driver.verify") lives in code (apps/api/src/common/permissions) rather
// than as a DB table — roles are the only thing that needs to be editable
// at runtime, the permission catalog itself is a deploy-time concern.
model AdminRoleDefinition {
  id          String   @id @default(uuid())
  // SUPER_ADMIN | ADMIN | OPERATIONS_ADMIN | VERIFICATION_ADMIN |
  // SAFETY_ADMIN | SUPPORT_ADMIN | FINANCE_ADMIN | CONTENT_ADMIN |
  // READ_ONLY_ADMIN — see packages/types AdminRole.
  key         String   @unique
  name        String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adminUsers AdminUser[]

  @@map("admin_role_definitions")
}

model AdminUser {
  // Same id as the corresponding Supabase auth user (mirrors User.id) —
  // set explicitly on creation, never left to the uuid() default in
  // real use. See apps/api/src/auth/auth.service.ts.
  id        String              @id @default(uuid())
  email     String              @unique
  fullName  String
  roleId    String
  role      AdminRoleDefinition @relation(fields: [roleId], references: [id])
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  auditLogs       AuditLog[]
  assignedReports Report[]       @relation("ReportAssignee")
  reportActions   ReportAction[]

  @@map("admin_users")
}

model AuditLog {
  id            String    @id @default(uuid())
  adminId       String
  admin         AdminUser @relation(fields: [adminId], references: [id])
  action        String
  module        String
  entity        String
  entityId      String
  previousValue Json?
  newValue      Json?
  result        String
  requestId     String?
  createdAt     DateTime  @default(now())

  @@index([adminId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum ReportType {
  USER
  DRIVER
  PASSENGER
  RIDE
  FRAUD
  SAFETY_INCIDENT

  @@map("report_type")
}

enum ReportStatus {
  NEW
  INVESTIGATING
  AWAITING_INFORMATION
  RESOLVED
  DISMISSED

  @@map("report_status")
}

model Report {
  id             String       @id @default(uuid())
  type           ReportType
  status         ReportStatus @default(NEW)
  reporterId     String
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id])
  reportedUserId String?
  reportedUser   User?        @relation("ReportReportedUser", fields: [reportedUserId], references: [id])
  tripId         String?
  trip           Trip?        @relation(fields: [tripId], references: [id])
  reason         String
  description    String?
  assignedAdminId String?
  assignedAdmin  AdminUser?   @relation("ReportAssignee", fields: [assignedAdminId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  actions ReportAction[]

  @@index([status])
  @@index([reportedUserId])
  @@map("reports")
}

model ReportAction {
  id        String    @id @default(uuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id])
  action    String
  note      String?
  createdAt DateTime  @default(now())

  @@index([reportId])
  @@map("report_actions")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("support_ticket_status")
}

// Phase 10: a lightweight ticket, not a CRM — one message per ticket (no
// threaded replies table; an admin's handling is the status transition
// itself, audited the same way every other admin write is). "category" is
// a free-form short string rather than an enum since the prototype's Help
// & Support FAQ doesn't define a fixed taxonomy to mirror.
model SupportTicket {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  subject   String
  message   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

// Schema only for now — no API endpoints or admin UI yet (see
// docs/migration-plan.md). Modeled so the eventual notification-delivery
// and settings-management work has a real table to land on instead of
// inventing one under deadline pressure, per "prepare backend integration
// architecture, don't fake delivery."
model NotificationTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  channel   String
  title     String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  category  String
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_settings")
}
